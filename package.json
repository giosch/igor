{
  "name": "igor-delegate",
  "version": "0.1.7",
  "description": "A local, supervised coding worker for Apple Silicon",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": { "node": ">=24 <25" },
  "bin": { "igor": "src/cli/index.js" },
